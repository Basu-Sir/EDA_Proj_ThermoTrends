# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
ENV/

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Data (preserve structure via .gitkeep, ignore raw dumps and large 15MB daily files)
data/raw/*.json
data/raw/*.csv
!data/raw/.gitkeep

data/processed/temperature_daily.csv
frontend/public/data/temperature_daily.csv
!data/processed/.gitkeep

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# OS Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Logs
outputs/logs/*
!outputs/logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Sensitive Config
.env
.env.*
!.env.example
